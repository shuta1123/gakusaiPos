# docker compose 用のルート環境変数（compose が自動で読み込む）。
# このファイルを .env にコピーし、本番では必ず値を変更すること。
# 未設定の場合は docker-compose.yml の開発用デフォルト値が使われる。

# 本番では production / false に
APP_ENV=local
APP_DEBUG=true

# 本番では必ず新しい値を生成して設定（`php artisan key:generate --show`）
APP_KEY=base64:+7BBJ1I+KgLR2mO9NxCYxEuQtlosGik35zlsmz6KE2w=

# データベース（本番では強固なパスワードに）
DB_DATABASE=gakusai_pos
DB_USERNAME=gakusai
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# スタッフ共通パスワード（本番では必ず変更）
STAFF_PASSWORD=gakusai2026

# Reverb（本番では新しい値を生成）
REVERB_APP_ID=891732
REVERB_APP_KEY=n93se9bles5oeqvj1gfq
REVERB_APP_SECRET=fyxsrmee39wjrq4qgipu

# フロントエンドがブラウザから参照する公開URL/ホスト。
# 本番（pos.shutay.com）では実際の公開ドメイン・HTTPS/WSSに変更すること。
