APP_NAME="学祭POS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- データベース（MySQL）---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gakusai_pos
DB_USERNAME=gakusai
DB_PASSWORD=secret

# --- セッション / キャッシュ / キュー（Redis）---
SESSION_DRIVER=redis
SESSION_LIFETIME=525600
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# --- Redis ---
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- ブロードキャスト（Laravel Reverb / WebSocket）---
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=891732
REVERB_APP_KEY=n93se9bles5oeqvj1gfq
REVERB_APP_SECRET=fyxsrmee39wjrq4qgipu
# Echo クライアントが接続するホスト（ブラウザから見たホスト名）
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Reverb サーバーの待受アドレス
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --- スタッフ共通パスワード ---
STAFF_PASSWORD=gakusai2026

MAIL_MAILER=log
