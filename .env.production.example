# 本番用（compose.prod.yml が読み込む）。このファイルを .env にコピーして値を設定する。
# ※ 本番の秘密情報。リポジトリにコミットしないこと（.env は .gitignore 済み）。

# --- アプリ ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://pos.shutay.com
# 生成: docker compose -f compose.prod.yml run --rm backend php artisan key:generate --show
APP_KEY=

# --- データベース（必ず強固なパスワードに）---
DB_DATABASE=gakusai_pos
DB_USERNAME=gakusai
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-strong-root

# --- スタッフ共通パスワード（必ず変更）---
STAFF_PASSWORD=change-me

# --- Reverb（本番用に新しい値を生成。例は openssl rand -hex 16 等）---
REVERB_APP_ID=change-me
REVERB_APP_KEY=change-me
REVERB_APP_SECRET=change-me

# --- ブラウザが参照する公開URL（フロントにビルド時焼き込み）---
# 本番(pos.shutay.com・単一ドメイン)ではこのままでOK。
NEXT_PUBLIC_API_BASE=https://pos.shutay.com/api
NEXT_PUBLIC_REVERB_HOST=pos.shutay.com
NEXT_PUBLIC_REVERB_PORT=443
NEXT_PUBLIC_REVERB_SCHEME=https

# CORS（単一ドメインなら不要。フォールバック等で別オリジンにする場合のみ設定）
# CORS_ALLOWED_ORIGINS=https://pos.shutay.com
